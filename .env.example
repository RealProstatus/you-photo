# Django & Configuration
SECRET_KEY=change-me-in-production-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database (S-ENV-02, S-REL-02)
POSTGRES_DB=youphoto
POSTGRES_USER=youphoto_user
POSTGRES_PASSWORD=youphoto_secret_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://youphoto_user:youphoto_secret_pass@localhost:5432/youphoto

# MinIO / S3 Object Storage (S-ENV-04, S-INT-01, S-SEC-04)
USE_MINIO=False
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=youphoto-orders
MINIO_USE_SSL=False
FILE_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=50

# Telegram & Apprise Notifications (FUNC 3.3, S-INT-02)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_telegram_bot_token
TELEGRAM_BOT_USERNAME=YouPhotoOrderBot
TELEGRAM_BIND_TOKEN_TTL_MINUTES=30

# Desktop Client Settings (S-ENV-07)
YOUPHOTO_API_BASE_URL=http://localhost:8000/api/v1
YOUPHOTO_HARDWARE_MOCK=True
